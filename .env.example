# Copy this file to .env.local and fill in. .env.local is never committed.
ANTHROPIC_API_KEY=
# Which Claude model to use
PLANT_AI_MODEL=claude-opus-5-5
# Set to 1 to use canned AI answers (no API credit used)
PLANT_AI_MOCK=0
# Model for the quick "Ask about <plant>" chat (faster and cheaper)
PLANT_CHAT_MODEL=claude-sonnet-5

# Where data lives: local (JSON file on this Mac) or supabase (cloud, with logins)
PLANT_STORE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Master key — scripts only (migration). Never share.
SUPABASE_SECRET_KEY=
